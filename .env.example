# Local development defaults
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///collaboration.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# Optional AWS S3 integration. Leave blank to use local uploads.
S3_BUCKET=
AWS_REGION=ap-south-1

# Initial administrator created on first run; change these before sharing/deployment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisNow123!
